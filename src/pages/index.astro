---
import Black from '../layouts/Black.astro';
import Swing from '../components/Swing.astro';
import Strengths from '../components/Strengths.astro';
import Story from '../components/Story.astro';
import { PROJECTS } from '../data.js';
import { TOOLS } from '../content.js';

const tests = Array.from({ length: 18 }, (_, i) => `TC-${String((i + 1) * 13).padStart(3, '0')}`);
---
<Black description="Sushanta Nandy, ISTQB-certified SDET in Gurugram. Test automation for wealth and asset management platforms: Playwright, Java, Appium. 40% faster release cycles at FNZ.">
  <section class="hero" aria-label="Intro">
    <!-- Entrance lives on inner spans: the outer elements own the scroll-out animation. -->
    <p class="hero-clock mono" aria-hidden="true"><span class="in in-deco" data-clock>00:00:00:00</span></p>
    <p class="hero-who mono"><span class="in in-support">Sushanta Nandy · SDET · Gurugram</span></p>
    <h1 class="hero-mark"><span class="sr">Sushanta Nandy</span><span class="in in-lead" aria-hidden="true">S<span class="dash"><Swing /></span>N</span></h1>
    <p class="hero-date mono" aria-hidden="true"><span class="in in-deco" data-date></span></p>
    <p class="hero-scroll mono"><span class="in in-deco in-late">(Scroll)</span></p>
  </section>

  <section class="sec statement" aria-labelledby="statement-h">
    <h2 id="statement-h" class="mega" data-reveal>
      <span>Testing the systems</span>
      <span class="indent">that move</span>
      <span>other people's money,</span>
      <span class="indent">end to end</span>
    </h2>
    <p class="lead" data-reveal>ISTQB-certified SDET with nearly 5 years in test automation, now in wealth and asset management. I migrate legacy suites to Playwright, build AI-assisted test tooling, and help run delivery for my pod. Based in Gurugram, India.</p>
  </section>

  <section class="sec" aria-labelledby="work-h">
    <p class="kicker mono">Selected work</p>
    <h2 id="work-h" class="mega mega-sm" data-reveal>
      <span>Nine projects.</span>
      <span>From a startup</span>
      <span>to an AI that</span>
      <span>writes the tests.</span>
    </h2>
    <ol class="worklist">
      {PROJECTS.map((p, i) => (
        <li data-reveal>
          <a href={`/work/#${p.id}`}>
            <span class="wl-n mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="wl-title">{p.title}</span>
            <span class="wl-result">{p.result}</span>
            <span class="wl-where mono">{p.where}</span>
          </a>
        </li>
      ))}
    </ol>
    <a class="marquee marquee-link" href="/work/">
      <span class="sr">See how each one was built</span>
      <span class="track" aria-hidden="true">{Array.from({ length: 8 }, () => <span>See how each one was built <b>→</b></span>)}</span>
    </a>
  </section>

  <Strengths heading="h3" />

  <section class="sec journey" aria-labelledby="journey-h">
    <div class="marquee" aria-hidden="true">
      <span class="track">{Array.from({ length: 3 }, () => TOOLS.map((t) => <span>{t}<i>—</i></span>))}</span>
    </div>
    <div class="marquee marquee-rev" aria-hidden="true">
      <span class="track">{Array.from({ length: 3 }, () => TOOLS.slice().reverse().map((t) => <span>{t}<i>—</i></span>))}</span>
    </div>
    <p class="runrow mono" aria-hidden="true">{tests.map((t, i) => <span style={`--i:${i}`}>{t}</span>)}</p>
    <h2 id="journey-h" class="mega mega-sm center" data-reveal>
      <span>Plan it.</span>
      <span>Automate it.</span>
      <span>Run it in CI.</span>
      <span>Prove it in numbers.</span>
    </h2>
    <p class="lead center" data-reveal>I decide what is worth automating, build the framework, wire it into Jenkins and BrowserStack, and report progress as burn-downs and goal-wise status that stakeholders can act on.</p>
  </section>

  <Story />
</Black>

<style>
  .hero { position: relative; height: 100svh; min-height: 560px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 var(--pad); }
  .hero-clock, .hero-date { font-size: clamp(.8rem, 1.3vw, 1.05rem); margin: 0; }
  .hero-date { justify-self: end; }
  .hero-mark { margin: 0; font-weight: 900; font-size: clamp(4.5rem, 14vw, 13rem); line-height: .8; letter-spacing: -.02em; position: relative; z-index: 1; }
  /* The dash is a drawn bar so the swing can hang from it without inheriting a stretched glyph. */
  .dash { position: relative; display: inline-block; width: 1.25em; height: .14em; margin-inline: .12em; background: currentColor; vertical-align: .3em; }
  .hero-who { position: absolute; left: 0; right: 0; top: calc(50% - clamp(4.6rem, 11vw, 9.5rem)); margin: 0; text-align: center; font-size: clamp(.75rem, 1.1vw, .95rem); color: var(--soft); }
  .hero-scroll { position: absolute; z-index: 2; left: 50%; bottom: 3%; transform: translateX(-50%); margin: 0; font-size: .75rem; color: var(--dim); }
  .statement { padding-top: clamp(40px, 6vw, 80px); }

  /* Hero entrance, once per visit. Lead: the S—N mark (carrying the swing) rises.
     Support: the name line follows, overlapping. Decoration: clock, date, (Scroll) fade in place. */
  .in { display: inline-block; animation: in-fade 500ms var(--ease) both; }
  .in-lead { animation: in-rise 700ms var(--ease) both; }
  .in-support { animation: in-rise-sm 600ms var(--ease) 120ms both; }
  .in-deco { animation-delay: 200ms; }
  .in-late { animation-delay: 600ms; }
  @keyframes in-fade { from { opacity: 0; } }
  @keyframes in-rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes in-rise-sm { from { opacity: 0; transform: translateY(8px); } }
  @media (prefers-reduced-motion: reduce) { .in, .in-lead, .in-support { animation: in-fade 300ms ease both; } }
  .worklist { list-style: none; margin: clamp(40px, 6vw, 80px) 0 0; padding: 0; border-top: 1px solid var(--line); }
  .worklist a { display: grid; grid-template-columns: 4ch minmax(0, 1.2fr) minmax(0, 1fr) 8ch; gap: 8px 24px; align-items: baseline; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; transition: color 200ms ease; }
  .wl-n, .wl-where { color: var(--dim); font-size: .8rem; }
  .wl-where { text-align: right; }
  .wl-title { font-weight: 800; text-transform: uppercase; letter-spacing: -.02em; font-size: clamp(1.3rem, 2.6vw, 2.2rem); line-height: 1; }
  .wl-result { color: var(--go); }
  .worklist a:active { color: var(--go); }
  @media (hover: hover) and (pointer: fine) {
    .wl-title { transition: transform 300ms var(--ease); }
    .worklist a:hover { color: var(--go); }
    .worklist a:hover .wl-title { transform: translateX(10px); }
  }
  @media (max-width: 700px) { .worklist a { grid-template-columns: 3ch minmax(0, 1fr); } .wl-result { grid-column: 2; } .wl-where { display: none; } }
  .journey .marquee { margin-top: 0; border-top: 0; }
  .journey .marquee + .marquee { border-top: 1px solid var(--line); }
  @media (max-width: 640px) {
    /* Text stacks above the mark; the swing hangs into the empty space below it. */
    .hero { grid-template-columns: 1fr; grid-template-rows: .6fr auto auto auto auto 1.6fr; justify-items: center; gap: 14px; }
    .hero-clock { grid-row: 2; } .hero-date { grid-row: 3; justify-self: center; } .hero-who { position: static; grid-row: 4; } .hero-mark { grid-row: 5; }
  }
</style>

<script>
  const clock = document.querySelector('[data-clock]');
  const pad = (n) => String(n).padStart(2, '0');
  let onScreen = true;
  const tick = () => {
    if (!onScreen) return;
    const d = new Date();
    clock.textContent = `${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}:${pad(Math.floor(d.getMilliseconds() / 10))}`;
    requestAnimationFrame(tick);
  };
  new IntersectionObserver(([e]) => { const was = onScreen; onScreen = e.isIntersecting; if (onScreen && !was) tick(); }).observe(clock);
  tick();
  const d = new Date();
  document.querySelector('[data-date]').textContent = `${d.toLocaleString('en', { month: 'short' }).toUpperCase()} ${d.getDate()} ${d.getFullYear()}`;</script>
