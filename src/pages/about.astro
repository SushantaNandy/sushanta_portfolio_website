---
import Black from '../layouts/Black.astro';
import { RECS, OFF_CLOCK, CREDENTIALS } from '../content.js';
import { LINKEDIN } from '../data.js';
---
<Black page="about" title="About" description="About Sushanta Nandy beyond the résumé: what colleagues say about him, his certifications, and what he does off the clock.">
  <section class="pagehead" aria-labelledby="about-h">
    <p class="kicker mono">About</p>
    <h1 id="about-h" class="mega"><span>From engines</span><span class="indent">to pipelines</span></h1>
  </section>

  <svg class="outline" viewBox="0 0 1000 380" aria-hidden="true" data-draw>
    <text x="500" y="340" text-anchor="middle">SN</text>
  </svg>

  <section class="sec intro" aria-label="Introduction">
    <p class="intro-lead" data-reveal>I'm the tester who files a bug report while buying a tent.</p>
    <p class="intro-body" data-reveal>Mechanical engineer by degree, SDET by choice. The career story is on the <a href="/">home page</a> and the projects are on the <a href="/work/">work page</a>. This page is about the person behind them: what the people I've worked with say, what I've studied, and what I do off the clock.</p>
  </section>

  <section class="sec" aria-labelledby="recs-h">
    <p class="kicker mono">In their words</p>
    <h2 id="recs-h" class="mega mega-sm" data-reveal><span>What my teams</span><span>say about me</span></h2>
    <div class="recs">
      {RECS.map((r) => {
        const words = r.quote.split(' ');
        return (
          <figure class="rec">
            <blockquote>
              <p><span class="q-mark" aria-hidden="true">“</span>{words.map((w, k) => <span class="qw" style={`--k:${(k / words.length).toFixed(3)}`}>{w} </span>)}</p>
            </blockquote>
            <figcaption>
              <span class="r-name">{r.name}</span>
              <span class="r-role mono">{r.role}</span>
              <span class="r-rel mono">{r.rel}</span>
            </figcaption>
          </figure>
        );
      })}
    </div>
    <a class="btn rec-more" href={`${LINKEDIN}/details/recommendations/`} rel="me">Read the full recommendations on LinkedIn <span aria-hidden="true">→</span></a>
  </section>

  <section class="sec" aria-labelledby="off-h">
    <p class="kicker mono">Off the clock</p>
    <h2 id="off-h" class="mega mega-sm" data-reveal><span>Not on</span><span>the résumé</span></h2>
    <ul class="off">
      {OFF_CLOCK.map((o) => (
        <li class="off-card" data-reveal>
          <span class="off-icon" aria-hidden="true">{o.icon}</span>
          <h3>{o.title}</h3>
          <p>{o.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="sec" aria-labelledby="cred-h">
    <p class="kicker mono">Certifications & honours</p>
    <h2 id="cred-h" class="mega mega-sm" data-reveal><span>Verified</span><span>along the way</span></h2>
    <ul class="creds">
      {CREDENTIALS.map((c, i) => (
        <li class="cred" data-cred style={`--d:${i}`}>
          <span class="seal" aria-hidden="true">✓</span>
          <span class="c-name">{c.name}</span>
          <span class="c-by mono">{c.by}{c.when && ` · ${c.when}`}</span>
        </li>
      ))}
    </ul>
  </section>
</Black>

<style>
  /* Outline draws itself once as it scrolls in. */
  .outline { display: block; width: min(100%, 1100px); margin: 0 auto; padding: 0 var(--pad); overflow: visible; user-select: none; }
  .outline text { font: 900 400px var(--sans); letter-spacing: -.04em; fill: none; stroke: var(--go); stroke-width: 3; stroke-dasharray: 2600; transition: stroke-dashoffset 1600ms var(--ease-in-out); }
  :global(.js) .outline text { stroke-dashoffset: 2600; }
  :global(.js) .outline.is-in text { stroke-dashoffset: 0; }

  .intro { display: grid; grid-template-columns: 1fr 1fr; gap: 32px 64px; align-items: start; }
  .intro-lead { margin: 0; font-weight: 750; font-size: clamp(1.6rem, 3vw, 2.6rem); line-height: 1.15; letter-spacing: -.02em; }
  .intro-body { margin: 0; color: var(--soft); line-height: 1.7; font-size: 1.05rem; max-width: 52ch; }
  .intro-body a { color: var(--fg); text-underline-offset: 4px; }

  /* Recommendations: each word inks in as the quote scrolls through the viewport. */
  .recs { display: grid; gap: clamp(16px, 2vw, 24px); margin-top: clamp(40px, 6vw, 80px); }
  .rec { margin: 0; padding: clamp(28px, 4vw, 56px); border: 1px solid #1c1c1c; border-radius: clamp(16px, 2.4vw, 32px); background: radial-gradient(120% 140% at 0% 0%, #0f2a1c 0%, #0b0b0b 55%); display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 24px 48px; align-items: end; }
  .rec:nth-child(2) { background: radial-gradient(120% 140% at 0% 0%, #1c1440 0%, #0b0b0b 55%); }
  .rec:nth-child(3) { background: radial-gradient(120% 140% at 0% 0%, #082a40 0%, #0b0b0b 55%); }
  .rec blockquote { margin: 0; }
  .rec blockquote p { margin: 0; font-weight: 650; font-size: clamp(1.35rem, 2.6vw, 2.3rem); line-height: 1.2; letter-spacing: -.015em; }
  .q-mark { color: var(--go); margin-right: .05em; }
  .rec figcaption { display: grid; gap: 6px; }
  .r-name { font-weight: 750; font-size: 1.1rem; }
  .r-role { color: var(--go); font-size: .78rem; }
  .r-rel { color: var(--dim); font-size: .72rem; }
  .rec-more { margin-top: 28px; }
  @media (hover: hover) and (pointer: fine) { .rec-more:hover { background: var(--fg); color: #000; } }
  .rec-more:active { transform: scale(.97); }
  @media (max-width: 760px) { .rec { grid-template-columns: 1fr; } }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .qw { animation: ink linear both; animation-timeline: view(); animation-range: cover calc(12% + var(--k) * 30%) cover calc(18% + var(--k) * 30%); }
    }
  }
  @keyframes ink { from { opacity: .16; } to { opacity: 1; } }

  /* Off the clock */
  .off { list-style: none; margin: clamp(40px, 6vw, 80px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: clamp(14px, 2vw, 22px); }
  .off-card { padding: 28px; border: 1px solid var(--line); border-radius: 22px; background: #0b0b0b; }
  .off-icon { display: inline-grid; place-items: center; width: 52px; height: 52px; border-radius: 16px; background: #141414; font-size: 1.5rem; transition: transform 300ms var(--ease); }
  .off-card h3 { margin: 22px 0 10px; font-size: 1.25rem; letter-spacing: -.01em; }
  .off-card p { margin: 0; color: var(--soft); line-height: 1.6; }
  @media (hover: hover) and (pointer: fine) {
    .off-card { transition: border-color 200ms ease; }
    .off-card:hover { border-color: #3a3a3a; }
    .off-card:hover .off-icon { transform: rotate(-8deg) scale(1.08); }
  }

  /* Credentials land like stamps, one after another. */
  .creds { list-style: none; margin: clamp(40px, 6vw, 80px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); gap: 12px; }
  .cred { position: relative; display: grid; gap: 8px; align-content: start; min-height: 132px; padding: 22px 22px 22px 22px; border: 1px solid var(--line); border-radius: 18px; }
  .seal { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 50%; border: 1.5px solid var(--go); color: var(--go); font-size: .85rem; margin-bottom: 6px; }
  .c-name { font-weight: 700; line-height: 1.25; }
  .c-by { color: var(--dim); font-size: .72rem; }
  :global(.js) .cred { opacity: 0; transform: scale(1.06) rotate(-2deg); transition: opacity 350ms var(--ease), transform 450ms var(--ease); transition-delay: calc(var(--d) * (60ms - var(--d) * 2.5ms)); }
  :global(.js) .creds.is-in .cred { opacity: 1; transform: none; }

  @media (max-width: 760px) { .intro { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .outline text { stroke-dashoffset: 0; transition: none; }
    :global(.js) .cred { transform: none; transition: opacity 300ms ease; transition-delay: 0ms; }
    .off-icon { transition: none; }
  }
</style>

<script>
  // Stamp the credentials in once the grid scrolls into view.
  const creds = document.querySelector('.creds');
  if (creds) new IntersectionObserver(([e], o) => { if (e.isIntersecting) { creds.classList.add('is-in'); o.disconnect(); } }, { threshold: 0.15 }).observe(creds);
</script>
