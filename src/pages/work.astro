---
import Black from '../layouts/Black.astro';
import { PROJECTS } from '../data.js';
const pad = (n) => String(n).padStart(2, '0');
const total = pad(PROJECTS.length);
const TINT = { migrate: '#2fd47a', ledger: '#ffc56b', ai: '#8b6cff', heal: '#2fd47a', bars: '#3fb6ff', health: '#2fd47a', mock: '#8b6cff', phones: '#3fb6ff', candles: '#ffc56b' };
const labelOf = (p) => (p.numbers[0] ? `${p.numbers[0][0]} ${p.numbers[0][1]}` : p.result.split(',')[0]);
---
<Black page="work" title="Work" description="Nine test automation projects by Sushanta Nandy across FNZ, Deutsche Telekom Digital Labs and Moolya: Playwright migration, AI test generation, self-healing Appium, E2E pipelines, app-health observability, API mocks.">
  <section class="pagehead" aria-labelledby="work-h">
    <p class="kicker mono">Work · {PROJECTS.length} projects</p>
    <h1 id="work-h" class="mega mega-sm"><span>What I built,</span><span>and what it changed</span></h1>
    <p class="lead">From 350+ mobile scripts at a startup to an AI that writes Playwright tests. Scroll, and watch each one get built.</p>
  </section>

  <section class="workshop" aria-label="Projects" data-workshop>
    <div class="stage" aria-hidden="true" data-stage>
      <canvas class="stage-canvas"></canvas>
      <p class="stage-cap mono"><span data-cap-n>01</span> / {total} · <span data-cap-t>{PROJECTS[0].title}</span></p>
    </div>

    <div class="projects">
      {PROJECTS.map((p, i) => (
        <article class="proj" id={p.id} data-proj data-scene={p.scene} data-label={labelOf(p)} data-tint={TINT[p.scene]} data-title={p.title} style={`--tint:${TINT[p.scene]}`}>
          <p class="p-meta mono"><b>{pad(i + 1)}</b> / {total} · {p.where} · {p.when}</p>
          <h2 class="p-title" data-reveal>{p.title}</h2>
          <p class="p-client mono" data-reveal>{p.client}</p>
          <p class="p-summary" data-reveal>{p.summary}</p>
          {p.numbers.length > 0 && (
            <dl class="p-nums" data-reveal>
              {p.numbers.map(([n, l]) => <div><dt>{n}</dt><dd>{l}</dd></div>)}
            </dl>
          )}
          <h3 class="p-h mono" data-reveal>What I built</h3>
          <ul class="p-built">{p.built.map((b, j) => <li data-reveal style={`--i:${j % 4}`}>{b}</li>)}</ul>
          <ul class="p-stack mono" aria-label="Tools">{p.stack.map((t) => <li>{t}</li>)}</ul>
          {p.href && <a class="btn p-case" href={p.href}>Read the case study <span aria-hidden="true">→</span></a>}
        </article>
      ))}
    </div>
  </section>
</Black>

<style>
  .pagehead .lead { margin-top: 28px; }
  .workshop { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(24px, 4vw, 64px); padding: 0 var(--pad) clamp(80px, 12vw, 160px); }
  .stage { position: sticky; top: 0; height: 100svh; grid-column: 2; grid-row: 1; }
  .stage-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .stage-cap { position: absolute; left: 0; right: 0; bottom: clamp(20px, 5vh, 48px); margin: 0; text-align: center; font-size: .75rem; color: var(--dim); }
  .stage-cap [data-cap-t] { color: var(--fg); }
  .projects { grid-column: 1; grid-row: 1; }

  .proj { min-height: 92svh; padding: 12vh 0 8vh; border-top: 1px solid var(--line); display: flex; flex-direction: column; justify-content: center; }
  .proj:first-child { border-top: 0; padding-top: 4vh; }
  .p-meta { margin: 0 0 18px; font-size: .78rem; color: var(--dim); }
  .p-meta b { color: var(--tint); font-weight: 700; }
  .p-title { margin: 0; font-weight: 850; text-transform: uppercase; letter-spacing: -.03em; line-height: .95; font-size: clamp(2rem, 4.2vw, 3.8rem); }
  .p-client { margin: 14px 0 0; color: var(--tint); font-size: .8rem; }
  .p-summary { margin: 22px 0 0; max-width: 56ch; color: var(--soft); line-height: 1.65; font-size: clamp(1rem, 1.3vw, 1.12rem); }
  .p-nums { display: flex; flex-wrap: wrap; gap: 18px 36px; margin: 28px 0 0; }
  .p-nums dt { font-weight: 850; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1; color: var(--tint); letter-spacing: -.03em; }
  .p-nums dd { margin: 6px 0 0; color: var(--dim); font-size: .9rem; max-width: 18ch; }
  .p-h { margin: 30px 0 4px; font-size: .75rem; color: var(--dim); font-weight: 600; }
  .p-built { list-style: none; margin: 0; padding: 0; max-width: 60ch; }
  .p-built li { position: relative; padding: 10px 0 10px 26px; border-top: 1px solid var(--line); line-height: 1.45; }
  .p-built li::before { content: '✓'; position: absolute; left: 2px; top: 10px; color: var(--tint); }
  .p-stack { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; font-size: .7rem; }
  .p-stack li { padding: 6px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--soft); }
  .p-case { align-self: flex-start; margin-top: 28px; }
  @media (hover: hover) and (pointer: fine) { .p-case:hover { background: var(--fg); color: #000; } }
  .p-case:active { transform: scale(.97); }

  /* No WebGL: the projects simply run full width. */
  .workshop.flat { grid-template-columns: minmax(0, 1fr); }
  .workshop.flat .stage { display: none; }

  /* Phones: the workshop pins as a band under the header and the projects scroll beneath it. */
  @media (max-width: 860px) {
    .workshop { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .stage { --head: calc(56px + env(safe-area-inset-top, 0px)); grid-column: 1; grid-row: 1; top: 0; height: calc(34svh + var(--head)); margin-inline: calc(var(--pad) * -1); z-index: 2; background: var(--bg); border-bottom: 1px solid var(--line); }
    .stage-canvas { top: var(--head); height: calc(100% - var(--head)); } /* opaque under the header too, so text never shows through */
    .stage-cap { bottom: 8px; }
    .projects { grid-row: 2; }
    .proj { min-height: 0; padding: 48px 0 56px; }
    .proj:first-child { padding-top: 32px; }
  }
</style>

<script>
  const root = document.querySelector('[data-workshop]');
  const projects = [...root.querySelectorAll('[data-proj]')];
  const capN = root.querySelector('[data-cap-n]'), capT = root.querySelector('[data-cap-t]');
  let shop = null, active = 0;
  const apply = () => {
    const p = projects[active];
    capN.textContent = String(active + 1).padStart(2, '0');
    capT.textContent = p.dataset.title;
    shop?.show(p.dataset.scene, p.dataset.label, p.dataset.tint);
  };
  // The project crossing the middle of the reading area is the one being built.
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { active = projects.indexOf(e.target); apply(); }
  }, { rootMargin: '-55% 0px -44% 0px' });
  projects.forEach((p) => io.observe(p));

  import('../scripts/workshop3d.js')
    .then(({ createWorkshop }) => {
      const stage = root.querySelector('[data-stage]');
      shop = createWorkshop(stage.querySelector('canvas'), stage);
      apply();
    })
    .catch(() => root.classList.add('flat')); // no WebGL: text only
</script>
