---
import Black from '../layouts/Black.astro';
import { EMAIL, RESUME, LINKEDIN, GITHUB } from '../data.js';
---
<Black page="contact" title="Contact" description="Contact Sushanta Nandy, SDET in Gurugram: email, résumé, LinkedIn and GitHub.">
  <section class="contact" aria-labelledby="contact-h">
    <p class="mono kicker">Hiring for a test automation role?</p>
    <h1 id="contact-h" class="c-h">Let's put your next release<br />through a proper gate.</h1>
    <figure class="hire" data-hire>
      <canvas class="hire-canvas" aria-hidden="true"></canvas>
      <figcaption>
        <ol class="hire-steps mono">
          <li class="is-on">You find my email</li>
          <li>We talk</li>
          <li>I join your team</li>
        </ol>
      </figcaption>
    </figure>
    <a class="btn btn-go" href={`mailto:${EMAIL}`}>Get in touch</a>
    <p class="c-mail"><span data-email>{EMAIL}</span> <button type="button" class="btn c-copy" data-copy={EMAIL}>Copy</button></p>
    <ul class="c-links">
      <li><a class="btn" href={RESUME} download>Download résumé</a></li>
      <li><a class="btn" href={LINKEDIN} rel="me">LinkedIn</a></li>
      <li><a class="btn" href={GITHUB} rel="me">GitHub</a></li>
    </ul>
    <p class="mono c-loc">Gurugram, India</p>
  </section>
</Black>

<style>
  .contact { min-height: 100svh; display: grid; place-content: center; justify-items: center; text-align: center; gap: 28px; padding: 120px var(--pad) 80px; }
  .contact .kicker { margin: 0; color: var(--soft); }
  .c-h { margin: 0; font-weight: 750; font-size: clamp(1.8rem, 4.4vw, 3.6rem); line-height: 1.15; letter-spacing: -.02em; }
  .c-mail { margin: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 12px; font-size: 1.1rem; }
  .c-copy { min-height: 40px; padding: 6px 16px; }
  .c-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .c-loc { color: var(--dim); font-size: .8rem; margin: 0; }
  /* The hiring story: a 3D loop above the contact options; the captions follow its three acts. */
  .hire { position: relative; width: min(1100px, calc(100vw - 2 * var(--pad))); height: clamp(300px, 46vh, 480px); margin: 0; }
  .hire-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .hire figcaption { position: absolute; left: 0; right: 0; bottom: 0; }
  .hire-steps { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 22px; font-size: .75rem; color: var(--dim); counter-reset: act; }
  .hire-steps li { counter-increment: act; transition: color 300ms ease; }
  .hire-steps li::before { content: counter(act) ' · '; }
  .hire-steps li.is-on { color: var(--go); }
</style>

<script>
  // Load the hiring story only when it is near the screen; the captions follow its acts.
  const hire = document.querySelector('[data-hire]');
  const steps = hire.querySelectorAll('.hire-steps li');
  new IntersectionObserver(([e], o) => {
    if (!e.isIntersecting) return;
    o.disconnect();
    import('../scripts/hire3d.js')
      .then(({ createHireScene }) => createHireScene(hire.querySelector('canvas'), hire, (act) => steps.forEach((li, i) => li.classList.toggle('is-on', i === act))))
      .catch(() => hire.querySelector('canvas').remove()); // no WebGL: the captions still tell the story
  }, { rootMargin: '200px 0px' }).observe(hire);
</script>
