---
// "Ask about Sushanta": a résumé assistant for recruiters, on every page. Answers stream from /api/chat.
const suggestions = [
  'What has he automated at FNZ?',
  'Which test frameworks does he know?',
  'Does he have wealth management experience?',
  'What results has he delivered?',
];
---
<div class="chat" data-chat>
  <section class="chat-panel" id="chat-panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
    <header class="chat-head">
      <div>
        <h2 id="chat-title" class="chat-title">Ask about Sushanta</h2>
        <p class="chat-sub">An AI assistant that answers from his résumé.</p>
      </div>
      <button type="button" class="chat-x" data-chat-close aria-label="Close chat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
    </header>
    <div class="chat-log" data-chat-log aria-live="polite">
      <p class="msg msg-bot">Hi! Ask me anything about Sushanta's experience, skills or results.</p>
      <ul class="chat-chips" data-chat-chips>
        {suggestions.map((s) => <li><button type="button" class="chip-q">{s}</button></li>)}
      </ul>
    </div>
    <form class="chat-form" data-chat-form>
      <label class="sr" for="chat-input">Your question</label>
      <input id="chat-input" name="q" type="text" autocomplete="off" enterkeyhint="send" maxlength="1000" placeholder="Type a question…" required />
      <button type="submit" class="chat-send" aria-label="Send question">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </button>
    </form>
    <p class="chat-note">AI answers can be wrong. For anything important, email Sushanta.</p>
  </section>
  <button type="button" class="chat-open" data-chat-open aria-expanded="false" aria-controls="chat-panel">
    <span class="chat-dot" aria-hidden="true"></span>Ask about Sushanta
  </button>
</div>

<style>
  .chat { position: fixed; z-index: 30; right: max(16px, env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); display: grid; justify-items: end; gap: 12px; font-family: var(--sans); }
  .chat-open { display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 12px 20px; border: 1.5px solid var(--fg); border-radius: 999px; background: var(--fg); color: #000; font: 650 .95rem/1 var(--sans); cursor: pointer; box-shadow: 0 10px 30px -10px rgb(0 0 0 / .8); transition: transform 160ms var(--ease), background-color 200ms ease, color 200ms ease; }
  .chat-open:active { transform: scale(.97); }
  .chat-open[aria-expanded='true'] { background: #000; color: var(--fg); }
  .chat-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--go); box-shadow: 0 0 0 3px rgb(47 212 122 / .25); }

  .chat-panel { width: min(380px, calc(100vw - 32px)); max-height: min(560px, calc(100dvh - 110px)); /* dvh: shrinks with the on-screen keyboard */ display: flex; flex-direction: column; background: #0b0b0b; color: var(--fg); border: 1px solid var(--line); border-radius: 18px; box-shadow: 0 24px 60px -16px rgb(0 0 0 / .9); overflow: hidden; transform-origin: bottom right; }
  .chat-panel[hidden] { display: none; }
  .chat-head { display: flex; justify-content: space-between; align-items: start; gap: 12px; padding: 16px 16px 12px 18px; border-bottom: 1px solid var(--line); }
  .chat-title { margin: 0; font-size: 1.05rem; font-weight: 700; }
  .chat-sub { margin: 4px 0 0; font-size: .82rem; color: var(--dim); }
  .chat-x { display: grid; place-items: center; width: 36px; height: 36px; border: 0; border-radius: 50%; background: none; color: var(--soft); cursor: pointer; }
  .chat-x:active { background: #1a1a1a; color: var(--fg); }
  .chat-log { flex: 1; min-height: 120px; overflow-y: auto; padding: 16px 18px; display: grid; align-content: start; gap: 10px; overscroll-behavior: contain; }
  /* Bubbles are created by script, so they don't carry Astro's scope attribute: style them globally under the log. */
  .chat-log :global(.msg) { margin: 0; max-width: 88%; padding: 10px 13px; border-radius: 14px; font-size: .93rem; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; }
  .chat-log :global(.msg-bot) { background: #161616; border-bottom-left-radius: 4px; }
  .chat-log :global(.msg-user) { justify-self: end; background: var(--fg); color: #000; border-bottom-right-radius: 4px; }
  .chat-log :global(.msg-bot.is-typing)::after { content: '▍'; margin-left: 2px; color: var(--go); animation: caret 900ms steps(1) infinite; }
  @keyframes caret { 50% { opacity: 0; } }
  .chat-chips { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .chip-q { padding: 8px 12px; border: 1px solid var(--line); border-radius: 999px; background: none; color: var(--soft); font: 500 .82rem/1.2 var(--sans); text-align: left; cursor: pointer; transition: border-color 160ms ease, color 160ms ease; }
  .chip-q:active { transform: scale(.97); }
  .chat-form { display: flex; gap: 8px; padding: 12px 12px 6px; border-top: 1px solid var(--line); }
  .chat-form input { flex: 1; min-width: 0; min-height: 44px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 999px; background: #000; color: var(--fg); font: 400 16px/1.2 var(--sans); caret-color: var(--go); }
  .chat-form input:focus-visible { outline: 2px solid var(--go); outline-offset: 1px; }
  .chat-send { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border: 0; border-radius: 50%; background: var(--go); color: #000; cursor: pointer; transition: transform 160ms var(--ease), opacity 160ms ease; }
  .chat-send:active { transform: scale(.94); }
  .chat-send:disabled { opacity: .45; cursor: default; }
  .chat-note { margin: 0; padding: 0 18px 12px; font-size: .72rem; color: var(--dim); }
  @media (hover: hover) and (pointer: fine) {
    .chip-q:hover { border-color: var(--soft); color: var(--fg); }
    .chat-x:hover { background: #1a1a1a; color: var(--fg); }
  }
  @media (prefers-reduced-motion: no-preference) {
    .chat-panel:not([hidden]) { animation: chat-in 220ms var(--ease) both; }
    @keyframes chat-in { from { opacity: 0; transform: translateY(8px) scale(.97); } }
  }
  @media (prefers-reduced-motion: reduce) { .chat-log :global(.msg-bot.is-typing)::after { animation: none; } }
</style>

<script>
  const root = document.querySelector('[data-chat]');
  const panel = root.querySelector('.chat-panel');
  const openBtn = root.querySelector('[data-chat-open]');
  const log = root.querySelector('[data-chat-log]');
  const chips = root.querySelector('[data-chat-chips]');
  const form = root.querySelector('[data-chat-form]');
  const input = form.querySelector('input');
  const send = form.querySelector('button');
  const history = [];
  let busy = false;

  const setOpen = (open) => {
    panel.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    if (open) input.focus();
    else openBtn.focus();
  };
  openBtn.addEventListener('click', () => setOpen(panel.hidden));
  root.querySelector('[data-chat-close]').addEventListener('click', () => setOpen(false));
  panel.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });

  const bubble = (cls, text) => {
    const p = document.createElement('p');
    p.className = `msg ${cls}`;
    p.textContent = text;
    log.append(p);
    log.scrollTop = log.scrollHeight;
    return p;
  };

  async function ask(question) {
    question = question.trim();
    if (!question || busy) return;
    busy = true;
    send.disabled = true;
    chips.remove();
    bubble('msg-user', question);
    history.push({ role: 'user', content: question });
    const out = bubble('msg-bot is-typing', '');
    let answer = '';
    try {
      const res = await fetch('/api/chat', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ messages: history }) });
      if (!res.ok || !res.body) {
        answer = (await res.text()) || 'Sorry, something went wrong. Please email nandysushanta8@gmail.com.';
      } else {
        const reader = res.body.getReader();
        const dec = new TextDecoder();
        for (;;) {
          const { value, done } = await reader.read();
          if (done) break;
          answer += dec.decode(value, { stream: true });
          out.textContent = answer;
          log.scrollTop = log.scrollHeight;
        }
      }
    } catch {
      answer = 'Network problem. Check your connection, or email nandysushanta8@gmail.com.';
    }
    out.textContent = answer;
    out.classList.remove('is-typing');
    if (answer) history.push({ role: 'assistant', content: answer });
    else history.pop(); // keep user/assistant turns paired
    busy = false;
    send.disabled = false;
    input.focus();
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value;
    input.value = '';
    ask(q);
  });
  chips.addEventListener('click', (e) => {
    const b = e.target.closest('.chip-q');
    if (b) ask(b.textContent);
  });
</script>
