---
import ProjectArt from './ProjectArt.astro';
const { p } = Astro.props;
---
<a class="card" href={p.href ?? `/work/#${p.id}`} id={p.id}>
  <span class="card-art" style={p.href ? 'view-transition-name: case-art' : undefined}><ProjectArt id={p.id} /></span>
  {p.href && <span class="badge">Case study</span>}
  <span class="card-meta">
    <span class="card-tag mono" style="display:block">{p.where} · {p.stack}</span>
    <span class="card-title" style="display:block">{p.title}</span>
    <span class="card-result" style="display:block">{p.result}</span>
  </span>
</a>
