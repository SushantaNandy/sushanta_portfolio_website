---
// A developer on a swing with a laptop, hung from the S—N dash. Original illustration.
const tokens = ['</>', '✓', '{ }', '200', 'PASS', '✓'];
---
<span class="swing" aria-hidden="true" data-swing>
  <svg viewBox="0 0 240 360">
    <!-- ropes and seat -->
    <path d="M84 0 L70 250 M156 0 L170 250" stroke="#cfcfcb" stroke-width="2.5" fill="none" />
    <rect x="58" y="247" width="124" height="10" rx="4" fill="#8a6a4a" />

    <!-- legs swing a little behind the seat -->
    <g class="legs">
      <rect x="100" y="252" width="15" height="62" rx="7" fill="#2a3442" />
      <rect x="125" y="252" width="15" height="62" rx="7" fill="#2a3442" />
      <ellipse cx="106" cy="316" rx="13" ry="7" fill="#2fd47a" />
      <ellipse cx="134" cy="316" rx="13" ry="7" fill="#2fd47a" />
    </g>

    <!-- body -->
    <rect x="90" y="178" width="60" height="78" rx="24" fill="#1f2a37" />
    <path d="M113 186 v18 M127 186 v18" stroke="#cfcfcb" stroke-width="2" stroke-linecap="round" />
    <!-- arms reaching to the keyboard -->
    <path d="M94 196 Q78 222 96 240 M146 196 Q162 222 144 240" stroke="#1f2a37" stroke-width="13" fill="none" stroke-linecap="round" />

    <!-- head -->
    <circle cx="120" cy="150" r="25" fill="#c68b5e" />
    <path d="M95 146 Q96 118 122 120 Q146 121 146 144 Q136 132 118 133 Q104 134 95 146 Z" fill="#141414" />
    <g class="eyes">
      <circle cx="111" cy="153" r="2.6" fill="#141414" />
      <circle cx="129" cy="153" r="2.6" fill="#141414" />
    </g>
    <path d="M102 153 a9 8 0 1 0 18 0 a9 8 0 1 0 -18 0 M120 153 h0 M120 153 a9 8 0 1 0 18 0 a9 8 0 1 0 -18 0" stroke="#e8e8e4" stroke-width="1.6" fill="none" />
    <path d="M114 165 q6 4 12 0" stroke="#141414" stroke-width="2" fill="none" stroke-linecap="round" />
    <!-- headphones -->
    <path d="M93 148 Q93 112 120 112 Q147 112 147 148" stroke="#e8e8e4" stroke-width="4" fill="none" />
    <rect x="88" y="140" width="10" height="18" rx="4" fill="#2fd47a" />
    <rect x="142" y="140" width="10" height="18" rx="4" fill="#2fd47a" />
    <!-- screen glow on the face -->
    <ellipse class="glow" cx="120" cy="166" rx="20" ry="9" fill="#2fd47a" opacity=".22" />

    <!-- laptop (lid faces us) -->
    <rect x="86" y="198" width="68" height="46" rx="5" fill="#d9dde3" />
    <text x="120" y="226" text-anchor="middle" font-family="monospace" font-size="13" font-weight="700" fill="#16a35a">&lt;/&gt;</text>
    <rect x="82" y="243" width="76" height="6" rx="3" fill="#aeb4bd" />

    <!-- code tokens drifting up from the laptop -->
    {tokens.map((t, i) => (
      <text class="token" x={i % 2 ? 160 : 52} y={212 - (i % 3) * 8} text-anchor={i % 2 ? 'start' : 'end'} style={`--i:${i}`} font-family="monospace" font-size="12" fill="#2fd47a">{t}</text>
    ))}
  </svg>
</span>

<style>
  .swing { --w: clamp(150px, 17vw, 250px); position: absolute; top: 100%; left: calc(50% - var(--w) / 2); width: var(--w); transform-origin: 50% 0; will-change: transform; cursor: grab; }
  .swing svg { width: 100%; height: auto; overflow: visible; }
  .legs { transform-box: fill-box; transform-origin: 50% 0; }
  .eyes { transform-box: fill-box; transform-origin: center; animation: blink 5s infinite; }
  @keyframes blink { 0%, 94%, 100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
  .glow { animation: flicker 2.4s ease-in-out infinite alternate; }
  @keyframes flicker { to { opacity: .1; } }
  .token { opacity: 0; animation: drift 3.6s linear infinite; animation-delay: calc(var(--i) * 600ms); }
  @keyframes drift {
    0% { opacity: 0; transform: translateY(0); }
    15% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-70px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyes, .glow, .token { animation: none; }
    .token { opacity: 0; }
    .swing { cursor: default; }
  }
</style>

<script>
  // Pendulum: θ'' = -(g/L)·sin θ - c·θ'. Cursor movement adds angular velocity; the swing
  // keeps its momentum and settles on its own, so pushes can interrupt it at any point.
  const swing = document.querySelector('[data-swing]');
  const legs = swing?.querySelector('.legs');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (swing && !reduce) {
    const G = 9;      // g/L: ~2s period, slow enough to read as a real swing
    const C = 0.75;   // damping: settles in a few swings, not forever
    const MAX = 1.1;  // radians; stops it looping over the bar
    let theta = 0.22, omega = 0, lastX = null, last = 0, running = false, visible = true;

    const render = () => {
      swing.style.transform = `rotate(${theta}rad)`;
      legs.style.transform = `rotate(${(-omega * 0.14).toFixed(4)}rad)`; // legs trail the motion
    };
    const step = (now) => {
      const dt = Math.min((now - last) / 1000, 1 / 30);
      last = now;
      omega += (-G * Math.sin(theta) - C * omega) * dt;
      theta = Math.max(-MAX, Math.min(MAX, theta + omega * dt));
      render();
      // Sleep when settled or off screen; the next push wakes it.
      if (visible && (Math.abs(theta) > 0.001 || Math.abs(omega) > 0.001)) requestAnimationFrame(step);
      else running = false;
    };
    const wake = () => { if (!running && visible) { running = true; last = performance.now(); requestAnimationFrame(step); } };

    addEventListener('pointermove', (e) => {
      if (lastX !== null) {
        // Rotating clockwise moves the seat left, so a rightward push is a negative impulse.
        omega = Math.max(-4, Math.min(4, omega - (e.clientX - lastX) * 0.004));
        wake();
      }
      lastX = e.clientX;
    }, { passive: true });
    swing.addEventListener('pointerdown', (e) => { omega -= Math.sign(e.offsetX - swing.clientWidth / 2 || 1) * 1.6; wake(); });

    new IntersectionObserver(([en]) => { visible = en.isIntersecting; if (visible) wake(); }).observe(swing);
    wake();
  }
</script>
