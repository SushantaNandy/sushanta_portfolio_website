---
// A developer on a swing with a laptop, hung from the S—N dash. Original illustration.
const tokens = ['</>', '✓', '{ }', '200', 'PASS', '✓'];
---
<span class="swing" aria-hidden="true" data-swing>
  <svg viewBox="0 0 240 360">
    <!-- ropes and seat -->
    <path d="M84 0 L70 250 M156 0 L170 250" stroke="#cfcfcb" stroke-width="2.5" fill="none" />
    <rect x="58" y="247" width="124" height="10" rx="4" fill="#8a6a4a" />

    <!-- legs swing a little behind the seat -->
    <g class="legs">
      <rect x="100" y="252" width="15" height="62" rx="7" fill="#2a3442" />
      <rect x="125" y="252" width="15" height="62" rx="7" fill="#2a3442" />
      <ellipse cx="106" cy="316" rx="13" ry="7" fill="#2fd47a" />
      <ellipse cx="134" cy="316" rx="13" ry="7" fill="#2fd47a" />
    </g>

    <!-- body -->
    <rect x="90" y="178" width="60" height="78" rx="24" fill="#1f2a37" />
    <path d="M113 186 v18 M127 186 v18" stroke="#cfcfcb" stroke-width="2" stroke-linecap="round" />
    <!-- arms reaching to the keyboard -->
    <path d="M94 196 Q78 222 96 240 M146 196 Q162 222 144 240" stroke="#1f2a37" stroke-width="13" fill="none" stroke-linecap="round" />

    <!-- head -->
    <circle cx="120" cy="150" r="25" fill="#c68b5e" />
    <path d="M95 146 Q96 118 122 120 Q146 121 146 144 Q136 132 118 133 Q104 134 95 146 Z" fill="#141414" />
    <g class="eyes">
      <circle cx="111" cy="153" r="2.6" fill="#141414" />
      <circle cx="129" cy="153" r="2.6" fill="#141414" />
    </g>
    <path d="M102 153 a9 8 0 1 0 18 0 a9 8 0 1 0 -18 0 M120 153 h0 M120 153 a9 8 0 1 0 18 0 a9 8 0 1 0 -18 0" stroke="#e8e8e4" stroke-width="1.6" fill="none" />
    <path d="M114 165 q6 4 12 0" stroke="#141414" stroke-width="2" fill="none" stroke-linecap="round" />
    <!-- headphones -->
    <path d="M93 148 Q93 112 120 112 Q147 112 147 148" stroke="#e8e8e4" stroke-width="4" fill="none" />
    <rect x="88" y="140" width="10" height="18" rx="4" fill="#2fd47a" />
    <rect x="142" y="140" width="10" height="18" rx="4" fill="#2fd47a" />
    <!-- screen glow on the face -->
    <ellipse class="glow" cx="120" cy="166" rx="20" ry="9" fill="#2fd47a" opacity=".22" />

    <!-- laptop (lid faces us) -->
    <rect x="86" y="198" width="68" height="46" rx="5" fill="#d9dde3" />
    <text x="120" y="226" text-anchor="middle" font-family="monospace" font-size="13" font-weight="700" fill="#16a35a">&lt;/&gt;</text>
    <rect x="82" y="243" width="76" height="6" rx="3" fill="#aeb4bd" />

    <!-- code tokens drifting up from the laptop -->
    {tokens.map((t, i) => (
      <text class="token" x={i % 2 ? 160 : 52} y={212 - (i % 3) * 8} text-anchor={i % 2 ? 'start' : 'end'} style={`--i:${i}`} font-family="monospace" font-size="12" fill="#2fd47a">{t}</text>
    ))}
  </svg>
  <canvas class="swing-3d"></canvas>
</span>

<style>
  .swing { --w: clamp(150px, 17vw, 250px); position: absolute; top: 100%; left: calc(50% - var(--w) / 2); width: var(--w); transform-origin: 50% 0; will-change: transform; cursor: grab; touch-action: none; /* the swing owns the drag; the page scrolls everywhere else */ }
  .swing.is-held { cursor: grabbing; }
  /* On touch screens a vertical swipe must still scroll the page; taps push the swing. */
  @media (pointer: coarse) { .swing { touch-action: pan-y; } }
  .swing svg { width: 100%; height: auto; overflow: visible; }
  /* The drawing is the fallback; once the lit 3D scene is up it takes over and the span stays as the grab target. */
  .swing-3d { position: absolute; display: none; pointer-events: none; }
  .swing.is-3d .swing-3d { display: block; }
  .swing.is-3d svg { visibility: hidden; }
  .legs { transform-box: fill-box; transform-origin: 50% 0; }
  .eyes { transform-box: fill-box; transform-origin: center; animation: blink 5s infinite; }
  @keyframes blink { 0%, 94%, 100% { transform: scaleY(1); } 96% { transform: scaleY(.1); } }
  .glow { animation: flicker 2.4s ease-in-out infinite alternate; }
  @keyframes flicker { to { opacity: .1; } }
  .token { opacity: 0; animation: drift 3.6s linear infinite; animation-delay: calc(var(--i) * 600ms); }
  @keyframes drift {
    0% { opacity: 0; transform: translateY(0); }
    15% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-70px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .eyes, .glow, .token { animation: none; }
    .token { opacity: 0; }
    .swing { cursor: default; }
  }
</style>

<script>
  // Pendulum swinging front-to-back (toward and away from the viewer), drawn as rotateX with
  // perspective: θ'' = -(g/L)·sin θ - c·θ'. θ > 0 = seat toward the viewer. Cursor wiggles and
  // taps add impulses; a pendulum only builds amplitude when pushed near its own rhythm, so
  // matching the swing's frequency makes it swing higher and off-beat pushes cancel out.
  const swing = document.querySelector('[data-swing]');
  const legs = swing?.querySelector('.legs');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  let three = null; // the 3D scene once loaded; until then (or without WebGL) the drawing swings

  if (swing) {
    import('../scripts/swing3d.js')
      .then(({ createSwing3D }) => {
        three = createSwing3D(swing.querySelector('.swing-3d'), swing);
        swing.classList.add('is-3d');
        swing.style.transform = '';
        three.pose(reduce ? 0 : theta, MAX);
      })
      .catch(() => {}); // no WebGL: keep the drawing
  }

  const MAX = 0.75; // radians; how far it may swing toward or away from the viewer
  let theta = 0.22;

  if (swing && !reduce) {
    const G = 9;      // g/L: ~2s period, slow enough to read as a real swing
    const C = 0.75;   // damping: settles in a few swings, not forever
    let omega = 0, lastX = null, lastY = null, last = 0, running = false, visible = true;
    let drag = null; // { id, y0, t0, hist: [{theta, t}], moved }

    // Past the limit the swing resists progressively instead of stopping dead.
    const rubberband = (x, d = 0.6, k = 0.55) => (x * d * k) / (d + k * Math.abs(x));
    const soft = (t) => (Math.abs(t) <= MAX ? t : Math.sign(t) * (MAX + rubberband(Math.abs(t) - MAX)));

    const render = () => {
      if (three) return three.pose(theta, MAX);
      swing.style.transform = `perspective(900px) rotateX(${theta.toFixed(4)}rad)`; // +rotateX brings the seat toward the viewer
      // Pumping: legs stretch out on the way forward, tuck under on the way back.
      legs.style.transform = `scaleY(${(1 - 0.3 * Math.max(0, -theta) / MAX).toFixed(3)})`;
    };
    const step = (now) => {
      const dt = Math.min((now - last) / 1000, 1 / 30);
      last = now;
      if (drag) { running = false; return; } // the finger owns it; physics resumes on release
      omega += (-G * Math.sin(theta) - C * omega) * dt;
      theta = Math.max(-MAX, Math.min(MAX, theta + omega * dt));
      render();
      // Sleep when settled or off screen; the next push wakes it.
      if (visible && (Math.abs(theta) > 0.001 || Math.abs(omega) > 0.001)) requestAnimationFrame(step);
      else running = false;
    };
    const wake = () => { if (!running && visible) { running = true; last = performance.now(); requestAnimationFrame(step); } };

    addEventListener('pointermove', (e) => {
      if (lastX !== null && !drag) {
        // Moving down or right pulls the seat toward you; up or left pushes it away.
        const d = (e.clientY - lastY) + (e.clientX - lastX);
        omega = Math.max(-4, Math.min(4, omega + d * 0.004));
        wake();
      }
      lastX = e.clientX; lastY = e.clientY;
    }, { passive: true });
    // Grab and swing it directly: dragging down pulls the seat toward you, up pushes it away,
    // 1:1 from where it was grabbed. It can be caught mid-swing, and on release keeps the hand's
    // velocity. A tap with no drag is a push in the direction it's already moving, so tapping
    // in rhythm pumps it higher, like pushing a real swing.
    const SWING_PX = 220; // drag distance that equals one radian
    swing.addEventListener('pointerdown', (e) => {
      swing.setPointerCapture(e.pointerId);
      drag = { id: e.pointerId, t0: theta, x0: e.clientX, y0: e.clientY, hist: [{ theta, t: e.timeStamp }], moved: false };
      omega = 0;
      swing.classList.add('is-held');
    });
    swing.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (!drag.moved && Math.hypot(e.clientX - drag.x0, e.clientY - drag.y0) < 6) return; // small hysteresis before it counts as a drag
      drag.moved = true;
      theta = soft(drag.t0 + (e.clientY - drag.y0) / SWING_PX);
      drag.hist.push({ theta, t: e.timeStamp });
      if (drag.hist.length > 6) drag.hist.shift();
      render();
    });
    const release = (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (drag.moved) {
        // Velocity handoff: continue at the hand's speed over the last ~80ms, so there's no seam.
        const h = drag.hist, a = h.find((p) => e.timeStamp - p.t < 80) ?? h[0], b = h[h.length - 1];
        omega = b.t > a.t ? Math.max(-6, Math.min(6, ((b.theta - a.theta) / (b.t - a.t)) * 1000)) : 0;
        theta = Math.max(-MAX, Math.min(MAX, theta));
      } else {
        omega += Math.sign(omega || 1) * 1.2; // tap = push along the current motion
      }
      drag = null;
      swing.classList.remove('is-held');
      wake();
    };
    swing.addEventListener('pointerup', release);
    swing.addEventListener('pointercancel', release);

    new IntersectionObserver(([en]) => { visible = en.isIntersecting; if (visible) wake(); }).observe(swing);
    wake();
  }
</script>
