---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/black.css';
import { RESUME, EMAIL, LINKEDIN, GITHUB } from '../data.js';
import ChatWidget from '../components/ChatWidget.astro';

const { title, description, page } = Astro.props;
const fullTitle = title ? `${title} · Sushanta Nandy` : 'Sushanta Nandy · SDET';
const nav = [
  { key: 'work', label: 'Work', href: '/work/' },
  { key: 'about', label: 'About', href: '/about/' },
  { key: 'contact', label: 'Contact', href: '/contact/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <!-- The site is always black, in both OS themes, so one colour matches the top of every page. -->
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="mark" href="/" aria-label="Sushanta Nandy, home">S<span aria-hidden="true">—</span>N</a>
      <nav aria-label="Main">
        <ul>
          {nav.map((n) => (
            <li class="nav-link"><a href={n.href} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a></li>
          ))}
          <li class="nav-menu"><button type="button" class="menu-btn" aria-haspopup="dialog" aria-controls="menu-sheet">Menu</button></li>
          <li><a class="pill" href={RESUME} download>Resume</a></li>
        </ul>
      </nav>
    </header>

    <!-- Phone menu: a bottom sheet you can drag or flick down to close (touch or mouse). -->
    <dialog class="sheet" id="menu-sheet" aria-label="Menu">
      <div class="sheet-scrim" data-sheet-close></div>
      <div class="sheet-panel" data-sheet-panel>
        <div class="sheet-grip" aria-hidden="true"><span></span></div>
        <ul class="sheet-links">
          <li><a href="/" aria-current={!page ? 'page' : undefined}>Home</a></li>
          {nav.map((n) => <li><a href={n.href} aria-current={page === n.key ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
        <ul class="sheet-extra mono">
          <li><a href={`mailto:${EMAIL}`}>Email</a></li>
          <li><a href={LINKEDIN} rel="me">LinkedIn</a></li>
          <li><a href={GITHUB} rel="me">GitHub</a></li>
          <li><a href={RESUME} download>Résumé</a></li>
        </ul>
        <button type="button" class="sheet-close" data-sheet-close>Close</button>
      </div>
    </dialog>

    <main id="main"><slot /></main>

    {page !== 'contact' && (
      <section class="gate" aria-labelledby="gate-h" data-gate>
        <div class="gate-copy">
          <p class="kicker mono">The release gate</p>
          <h2 id="gate-h" class="gate-h">Every build goes through the gate. The broken ones never reach your users.</h2>
        </div>
        <canvas class="gate-canvas" aria-hidden="true"></canvas>
      </section>
    )}

    <footer class="foot">
      <div class="foot-grid">
        <div class="foot-info">
          <a class="foot-mail" href={`mailto:${EMAIL}`}>{EMAIL}</a>
          <p>Gurugram, India</p>
        </div>
        <ul class="foot-nav">
          <li><a href="/work/">Work</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
        <ul class="foot-tags mono">
          <li><a href={LINKEDIN} rel="me">#LinkedIn</a></li>
          <li><a href={GITHUB} rel="me">#GitHub</a></li>
          <li><a href={RESUME} download>#Resume</a></li>
        </ul>
      </div>
      {page !== 'contact' && (
        <>
          <h2 class="mega mega-sm"><span>Your next release</span><span>deserves a gate</span></h2>
          <p class="lead">Hiring an SDET for a wealth or fintech platform? Email me, or grab the résumé.</p>
          <a class="cta" href={`mailto:${EMAIL}`} data-cta>
            <span class="sr">Get in touch by email</span>
            <svg class="cta-line" viewBox="0 0 1200 420" preserveAspectRatio="none" aria-hidden="true">
              <path pathLength="1" d="M-20 400 C 160 400 220 240 330 250 C 450 262 420 390 330 360 C 230 326 300 170 470 150 C 640 130 700 260 820 210 C 930 165 960 60 1220 30" />
            </svg>
            <span class="cta-word" aria-hidden="true">
              {'Get in touch'.split('').map((c, i) => (
                <span class="cta-ch" style={`--i:${i}; --r:${(i % 2 ? 1 : -1) * (6 + (i * 7) % 11)}deg`}>{c === ' ' ? ' ' : c}</span>
              ))}
              <span class="cta-ch cta-arrow" style="--i:12; --r:0deg">→</span>
            </span>
          </a>
        </>
      )}
      <p class="copy mono">© {new Date().getFullYear()} Sushanta Nandy</p>
    </footer>

    <ChatWidget />

    <script>
      // Menu sheet. Track phase: while the pointer is down the panel follows it 1:1 (direct transform,
      // no easing). Release phase: dismiss on distance OR a fast flick, else snap back. CSS transitions,
      // never keyframes, so it can be caught and dragged again mid-flight.
      {
        const sheet = document.getElementById('menu-sheet');
        const panel = sheet.querySelector('[data-sheet-panel]');
        const scrim = sheet.querySelector('.sheet-scrim');
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const SHEET = 'cubic-bezier(0.32, 0.72, 0, 1)', OUT = 'cubic-bezier(0.23, 1, 0.32, 1)';
        let drag = null, dragged = false, closing = 0;
        const place = (y, ms = 0, ease = SHEET) => {
          const t = ms && !still ? `${ms}ms ${ease}` : '0ms';
          panel.style.transition = `transform ${t}`;
          scrim.style.transition = `opacity ${t}`;
          panel.style.transform = `translate3d(0, ${y}px, 0)`;
          scrim.style.opacity = String(Math.max(0, 1 - y / panel.offsetHeight)); // overlay follows the panel
        };
        const open = () => {
          clearTimeout(closing);
          if (!sheet.open) sheet.showModal();
          place(panel.offsetHeight);
          panel.getBoundingClientRect(); // commit the start position before animating in
          place(0, 500);
        };
        const close = (ms = 300, ease = SHEET) => {
          place(panel.offsetHeight, ms, ease);
          clearTimeout(closing);
          closing = setTimeout(() => sheet.close(), still ? 0 : ms);
        };
        document.querySelector('.menu-btn').addEventListener('click', open);
        sheet.querySelectorAll('[data-sheet-close]').forEach((el) => el.addEventListener('click', () => close()));
        sheet.addEventListener('cancel', (e) => { e.preventDefault(); close(); }); // Esc animates out too

        panel.addEventListener('pointerdown', (e) => {
          if (e.button !== 0) return;
          clearTimeout(closing); // caught mid-close: it stays open under the finger
          const y = new DOMMatrix(getComputedStyle(panel).transform).m42;
          drag = { id: e.pointerId, y0: e.clientY, start: y, moved: false, hist: [{ y, t: e.timeStamp }] };
          place(y);
        });
        panel.addEventListener('pointermove', (e) => {
          if (!drag || e.pointerId !== drag.id) return;
          const dy = e.clientY - drag.y0;
          if (!drag.moved) {
            if (Math.abs(dy) < 6) return; // small slop so taps on links stay taps
            drag.moved = true;
            try { panel.setPointerCapture(e.pointerId); } catch {} // keep tracking outside the panel; harmless if unsupported
          }
          let y = drag.start + dy;
          if (y < 0) y *= 0.2; // rubber-band past the top instead of a hard stop
          place(y);
          drag.hist.push({ y, t: e.timeStamp });
          if (drag.hist.length > 6) drag.hist.shift();
        });
        const release = (e) => {
          if (!drag || e.pointerId !== drag.id) return;
          const { moved, hist } = drag;
          drag = null;
          const y = new DOMMatrix(getComputedStyle(panel).transform).m42, h = panel.offsetHeight;
          if (!moved) { if (y !== 0) place(0, 200, OUT); return; } // a tap that caught it mid-flight
          dragged = true;
          setTimeout(() => (dragged = false), 0);
          const a = hist.find((p) => e.timeStamp - p.t < 80) ?? hist[0], b = hist[hist.length - 1];
          const v = b.t > a.t ? (b.y - a.y) / (b.t - a.t) : 0; // px per ms, positive is downward
          if (y > h * 0.4 || v > 0.5) close(Math.min(400, Math.max(150, (h - y) / Math.max(v, 1))), OUT); // leaves at the flick's speed
          else place(0, 200, OUT); // didn't make it: snap back quickly
        };
        panel.addEventListener('pointerup', release);
        panel.addEventListener('pointercancel', release);
        panel.addEventListener('click', (e) => { if (dragged) { e.preventDefault(); e.stopPropagation(); } }, true); // a drag is not a tap
      }

      // Reveal once on scroll; content is visible without JS.
      // Stagger siblings that reveal together (strength columns, list rows, cards).
      // Only for items that enter together (a grid row, a run of list rows). Panels that scroll
      // in one at a time get no delay; they only need their stacking offset.
      document.querySelectorAll('.honours, .cards-grid').forEach((g) =>
        [...g.children].forEach((c, i) => { const t = c.matches('[data-reveal]') ? c : c.querySelector('[data-reveal]'); if (t) t.style.setProperty('--i', String(i % 4)); }));
      document.querySelectorAll('.role').forEach((r, i) => r.style.setProperty('--stack', String(i)));
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      // Smoke headlines: wrap each word so it can condense out of a blur as it scrolls in (CSS does the motion).
      document.querySelectorAll('.mega > span').forEach((line) => {
        if (line.children.length) return;
        const words = line.textContent.trim().split(/\s+/);
        line.replaceChildren(...words.flatMap((w, i) => {
          const s = document.createElement('span');
          s.className = 'smoke-w';
          s.textContent = w;
          s.style.setProperty('--w', String(i));
          return i ? [' ', s] : [s];
        }));
      });

      // Release gate: load the 3D scene only when it is about to scroll into view.
      const gate = document.querySelector('[data-gate]');
      if (gate) new IntersectionObserver(([e], o) => {
        if (!e.isIntersecting) return;
        o.disconnect();
        import('../scripts/gate3d.js').then(({ createGate }) => createGate(gate.querySelector('canvas'), gate)).catch(() => {});
      }, { rootMargin: '300px 0px' }).observe(gate);

      // Footer CTA: draw the line, then pop the letters, once it is mostly on screen.
      // Also drives any self-drawing outline ([data-draw]).
      const drawIO = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); drawIO.unobserve(e.target); }
      }, { threshold: 0.45 });
      document.querySelectorAll('[data-cta], [data-draw]').forEach((el) => drawIO.observe(el));

      for (const btn of document.querySelectorAll('[data-copy]')) {
        const label = btn.textContent;
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        // Blur crossfade: the label softens, swaps, and sharpens, so it reads as one button changing state.
        const swap = async (text) => {
          const out = still ? [{ opacity: 1 }, { opacity: 0.4 }] : [{ opacity: 1, filter: 'blur(0)' }, { opacity: 0.7, filter: 'blur(2px)' }];
          await btn.animate(out, { duration: 100, easing: 'ease', fill: 'forwards' }).finished;
          btn.textContent = text;
          btn.animate(out.slice().reverse(), { duration: 100, easing: 'ease', fill: 'forwards' });
        };
        btn.addEventListener('click', async () => {
          try { await navigator.clipboard.writeText(btn.dataset.copy); swap('Copied'); }
          catch { swap('Press Ctrl+C'); getSelection().selectAllChildren(document.querySelector('[data-email]')); }
          clearTimeout(btn._t);
          btn._t = setTimeout(() => swap(label), 1800);
        });
      }
    </script>
  </body>
</html>
